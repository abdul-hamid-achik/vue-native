{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/runtime": {
      "ignoreDependencies": ["@vue/shared"]
    },
    "packages/navigation": {},
    "packages/vite-plugin": {},
    "packages/cli": {},
    "examples/*": {},
    "examples/native-blocks-demo": {
      "ignore": ["app/**"],
      "ignoreDependencies": ["@thelacanians/vue-native-runtime", "@thelacanians/vue-native-navigation"]
    },
    "tools/vscode-extension": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["vsce"]
    }
  },
  "ignore": [
    "native/**",
    "docs/**",
    "fixtures/**"
  ],
  "exclude": ["classMembers", "exports", "types", "duplicates"],
  "ignoreBinaries": ["swift"]
}
