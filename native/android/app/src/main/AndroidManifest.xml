<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No android:icon / android:roundIcon: this module ships no mipmap resources,
      so referencing @mipmap/ic_launcher made :app:processDebugResources fail with
      "resource mipmap/ic_launcher not found" (pre-existing — the example app could
      not be assembled at all). Add res/mipmap-*/ic_launcher.png here if you want
      a branded launcher icon.
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VueNativeCounter"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          configChanges is required: without it Android recreates the Activity on
          rotation / dark-mode / locale change, which destroys the V8 isolate
          and wipes all JS state (component state, stores, navigation stack).
          windowSoftInputMode="adjustResize" is what VueNativeActivity's IME
          inset handling expects. See the VueNativeActivity KDoc.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|locale|layoutDirection|fontScale|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
